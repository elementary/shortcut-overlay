#: src/MainWindow.vala:23
msgid "Shortcuts"
msgstr "Դյուրանցումներ"

#: src/MainWindow.vala:30
msgid "Keyboard Settings…"
msgstr "Ստեղնաշարի կարգավորումներ…"

#: src/ShortcutLabel.vala:77
msgid "Disabled"
msgstr "Անջատված"

#: src/Views/ShortcutsView.vala:32
msgid "Windows"
msgstr "Պատուհաններ"

#: src/Views/ShortcutsView.vala:40
msgid "Close window:"
msgstr "Փակել պատուհանը՝"

#: src/Views/ShortcutsView.vala:41
msgid "Cycle windows:"
msgstr "Շրջել պատուհանների միջև՝"

#: src/Views/ShortcutsView.vala:42
msgid "Toggle maximized:"
msgstr "Փոխարկել ընդլայնումը՝"

#: src/Views/ShortcutsView.vala:43
msgid "Tile left:"
msgstr "Սալիկավորել ձախ՝"

#: src/Views/ShortcutsView.vala:44
msgid "Tile right:"
msgstr "Սալիկավորել աջ՝"

#: src/Views/ShortcutsView.vala:45
msgid "Move to left workspace:"
msgstr "Տեղափոխել ձախ աշխատանքային տարածք՝"

#: src/Views/ShortcutsView.vala:46
msgid "Move to right workspace:"
msgstr "Տեղափոխել աջ աշխատանքային տարածք՝"

#: src/Views/ShortcutsView.vala:47
msgid "Picture in Picture Mode:"
msgstr "«Պատկեր պատկերում» ռեժիմ՝"

#: src/Views/ShortcutsView.vala:54
msgid "Workspaces"
msgstr "Աշխատանքային տարածքներ"

