#: src/Views/ShortcutsView.vala:123
msgid "Notifications Menu:"
msgstr "Ծանուցումների ցանկ՝"

#: src/Views/ShortcutsView.vala:124
msgid "Cycle display mode:"
msgstr "Շրջել էկրանի ռեժիմների միջև՝"

#: src/Views/ShortcutsView.vala:125
msgid "Zoom in:"
msgstr "Խոշորացնել՝"

#: src/Views/ShortcutsView.vala:126
msgid "Zoom out:"
msgstr "Փոքրացնել՝"

#: src/Views/ShortcutsView.vala:127
msgid "Lock screen:"
msgstr "Կողպել էկրանը՝"

#: src/Views/ShortcutsView.vala:128
msgid "Log out:"
msgstr "Դուրս գալ՝"

#: src/Views/ShortcutsView.vala:129
msgid "Switch keyboard layout:"
msgstr "Փոխել ստեղնաշարի դասավորությունը՝"

#: src/Views/ShortcutsView.vala:130
msgid "Toggle on-screen keyboard:"
msgstr "Փոխարկել էկրանային ստեղնաշարը՝"

#: src/Views/ShortcutsView.vala:131
msgid "Toggle screen reader:"
msgstr "Փոխարկել էկրանի ընթերցիչը՝"

#: src/Views/ShortcutsView.vala:138
msgid "Screenshots"
msgstr "Էկրանի նկարներ"

#: src/Views/ShortcutsView.vala:146
msgid "Grab the whole screen:"
msgstr "Նկարել ամբողջ էկրանը՝"

#: src/Views/ShortcutsView.vala:147
msgid "Copy the whole screen to clipboard:"
msgstr "Պատճենել ամբողջ էկրանը Սեղմատախտակ՝"

#: src/Views/ShortcutsView.vala:148
msgid "Grab the current window:"
msgstr "Նկարել ընթացիկ պատուհանը՝"

#: src/Views/ShortcutsView.vala:149
msgid "Copy the current window to clipboard:"
msgstr "Պատճենել ընթացիկ պատուհանը Սեղմատախտակ՝"

#: src/Views/ShortcutsView.vala:150
msgid "Select an area to grab:"
msgstr "Ընտրել նկարվող տարածքը՝"

#: src/Views/ShortcutsView.vala:151
msgid "Copy an area to clipboard:"
msgstr "Պատճենել տարածքը Սեղմատախտակ՝"
