msgstr "Անցնել նորին՝"

#: src/Views/ShortcutsView.vala:67
msgid "Cycle workspaces:"
msgstr "Շրջել աշխատանքային տարածքների միջև՝"

#: src/Views/ShortcutsView.vala:114
msgid "System"
msgstr "undefined"

