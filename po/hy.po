msgid "Switch left:"
msgstr "Անցնել ձախ՝"

#: src/Views/ShortcutsView.vala:64
msgid "Switch right:"
msgstr "Անցնել աջ՝"

#: src/Views/ShortcutsView.vala:65
msgid "Switch to first:"
msgstr "Անցնել առաջինին՝"

#: src/Views/ShortcutsView.vala:66
